generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int          @id @default(autoincrement())
  email              String       @unique
  password           String
  name               String
  role               UserRole     @default(USER) 
  groupRole          String       @default("MIEMBRO") 
  avatarUrl          String?
  birthDate          DateTime?    
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  administeredGroups GroupSmall[] @relation("GroupAdministrator")
  groupSmallId       Int?         
  groupSmall         GroupSmall?  @relation("GroupMembers", fields: [groupSmallId], references: [id], onDelete: SetNull)
  scores             Score[]
  createdActivities  Activity[]   @relation("UserCreatedActivities")
  extraParticipantScores ExtraParticipantScore[]
}

model GroupSmall {
  id              Int        @id @default(autoincrement())
  name            String     @unique
  description     String?
  motto           String?   
  bibleVerse      String?    
  anthemUrl       String?    
  leaderName      String?    
  subLeaderName   String?    
  totalPoints     Int        @default(0)
  variation       Int        @default(0)
  administratorId Int
  administrator   User       @relation("GroupAdministrator", fields: [administratorId], references: [id], onDelete: Cascade)
  members         User[]     @relation("GroupMembers")
  scores          Score[]
  penalties       Penalty[]
  createdAt       DateTime   @default(now())
  eventParticipations EventParticipation[]
  extraGroupScores       ExtraGroupScore[]
  extraParticipantScores ExtraParticipantScore[]
}

enum UserRole {
  ADMIN
  USER
}

model Score {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId Int
  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  groupId    Int
  groupSmall GroupSmall @relation(fields: [groupId], references: [id], onDelete: Cascade)
  points     Int
  date       DateTime   @default(now())
}

model Activity {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  points          Int
  date            DateTime      @default(now())
  createdById     Int
  createdBy       User          @relation("UserCreatedActivities", fields: [createdById], references: [id], onDelete: Cascade)
  groupSmallId    Int
  pointCategoryId Int
  pointCategory   PointCategory @relation(fields: [pointCategoryId], references: [id], onDelete: Cascade)
  scores          Score[]
}

model PointCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  activities  Activity[]
}

model Penalty {
  id           Int        @id @default(autoincrement())
  reason       String
  points       Int
  groupSmallId Int
  groupSmall   GroupSmall @relation(fields: [groupSmallId], references: [id], onDelete: Cascade)
  date         DateTime   @default(now())
}

model ProgramEvent {
  id          Int      @id @default(autoincrement())
  timeSlot    String   
  title       String   
  description String?  
  responsible String   
  order       Int      @default(0) 
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id             Int                  @id @default(autoincrement())
  title          String
  description    String?
  category       String               
  typeTag        String               
  startDate      String               
  timeSlot       String               
  location       String
  maxSpots       Int                  @default(15)
  status         String               
  imageUrl       String?              @default("")
  pdfUrl         String?              @default("")
  createdAt      DateTime             @default(now())
  participations EventParticipation[]
}

model EventParticipation {
  id               Int        @id @default(autoincrement())
  eventId          Int
  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  groupId          Int
  groupSmall       GroupSmall @relation(fields: [groupId], references: [id], onDelete: Cascade)
  enrolledAt       DateTime   @default(now())
  status           String     @default("Inscrito") 
  confirmedMembers String     @default("")

  @@unique([eventId, groupId])
}

model Material {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  type        String   // 'PDF' or 'IMAGE'
  size        String   // e.g. "2.4 MB"
  category    String   // e.g. "Reglamentos", "Capacitación"
  fileUrl     String   // Path/URL to the primary uploaded file
  type2       String?  @default("")
  size2       String?  @default("")
  fileUrl2    String?  @default("")
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MaterialCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model ExtraScoreboard {
  id                Int                     @id @default(autoincrement())
  title             String
  description       String?
  eventType         String                  @default("Campamento") // 'Campamento', 'Rally', 'Olimpiada', 'Concurso'
  status            String                  @default("ACTIVO")     // 'ACTIVO', 'FINALIZADO'
  imageUrl          String?                 @default("")
  pdfUrl            String?                 @default("")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  challenges        ScoreChallenge[]
  groupScores       ExtraGroupScore[]
  participantScores ExtraParticipantScore[]
}

model ScoreChallenge {
  id                Int                     @id @default(autoincrement())
  scoreboardId      Int
  scoreboard        ExtraScoreboard         @relation(fields: [scoreboardId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  category          String                  @default("Desafío General")
  maxPoints         Int                     @default(100)
  createdAt         DateTime                @default(now())
  groupScores       ExtraGroupScore[]
  participantScores ExtraParticipantScore[]
}

model ExtraGroupScore {
  id            Int             @id @default(autoincrement())
  scoreboardId  Int
  scoreboard    ExtraScoreboard @relation(fields: [scoreboardId], references: [id], onDelete: Cascade)
  groupId       Int
  groupSmall    GroupSmall      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  challengeId   Int?
  challenge     ScoreChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  points        Int
  reason        String
  awardedByName String?         @default("Administración")
  createdAt     DateTime        @default(now())
}

model ExtraParticipantScore {
  id            Int             @id @default(autoincrement())
  scoreboardId  Int
  scoreboard    ExtraScoreboard @relation(fields: [scoreboardId], references: [id], onDelete: Cascade)
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId       Int?
  groupSmall    GroupSmall?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  challengeId   Int?
  challenge     ScoreChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  points        Int
  reason        String
  awardedByName String?         @default("Administración")
  createdAt     DateTime        @default(now())
}